rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kho chuẩn: mọi app có thể tra barcode, chỉ tài khoản đã đăng nhập mới được ghi.
    match /products/{barcode} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Bản ghi thu thập: chỉ người đã đăng nhập.
    match /productSubmissions/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Dữ liệu cửa hàng: dành cho bước kết nối Sổ Tạp Hóa Cloud tiếp theo.
    match /stores/{storeId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}